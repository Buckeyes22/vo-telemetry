# Safe local configuration. Generate your own token; never commit a live .env.
LIVENESS_BIND_HOST=127.0.0.1
LIVENESS_BIND_PORT=8723
LIVENESS_DB_PATH=./data/liveness/events.db
LIVENESS_INGEST_TOKEN=
LIVENESS_INGEST_URL=http://127.0.0.1:8723/ingest
LIVENESS_STORE_FULL_FINAL_MESSAGE=false
WATCHER_API_BASE=http://127.0.0.1:8723
WATCHER_DRY_RUN=true
WATCHER_ALLOWED_ACTIONS=
WATCHER_AUDIT_LOG=./data/watcher-audit.jsonl
WATCHER_TELEGRAM_TOKEN=
WATCHER_TELEGRAM_CHAT_ID=
CC_HOST_ALLOW_UNRESTRICTED=0
CLAUDE_TELEMETRY_HOME=./data/producer
CC_HOST_OUTBOX_DIR=./data/producer/outbox
QWEN_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
QWEN_OPENAI_API_KEY=
QWEN_MODEL=your-model-id
